msgid ""
"When a message arrives whose \"command\" and \"args\" match a row, the program "
"runs that row's Command to Run.\n\n"
"Command line arguments may contain $1, $2, ... which are replaced by the "
"payload's \"param1\", \"param2\", ... A $X with no matching param is removed.\n\n"
"Example payload: {\"command\": \"notify\", \"args\": \"test\", \"param1\": "
"\"hello\", \"param2\": \"world\"}"
msgstr ""
